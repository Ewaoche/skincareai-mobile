{
  "expo": {
    "name": "SkincareAI",
    "slug": "skincareai-mobile",
    "scheme": "skincareai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F7"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
